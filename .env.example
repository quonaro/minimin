ORCHESTRATOR_API_KEY=your-secret-api-key-here
ORCHESTRATOR_API_BIND=:8081
MC_SERVERS_DIR=/app/servers
MC_SERVERS_HOST_DIR=/absolute/path/to/servers
MC_INSTANCE_FILE=/app/data/instance.yml
ORCHESTRATOR_LOG_LEVEL=info
ORCHESTRATOR_LOG_FORMAT=text
# Optional custom Modrinth API base URL (defaults to https://api.modrinth.com/v2)
MODRINTH_CUSTOM_URL=
